{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Truth Filtering Engine Design Tokens",
    "version": "0.1.0",
    "brand": "진실의 입",
    "tagline": "TRUTH GUARD"
  },
  "primitive": {
    "color": {
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "black": { "$type": "color", "$value": "#111827" },
      "ink": { "$type": "color", "$value": "#2E2E4E" },
      "slate50": { "$type": "color", "$value": "#F8FAFC" },
      "slate100": { "$type": "color", "$value": "#F1F5F9" },
      "slate200": { "$type": "color", "$value": "#E2E8F0" },
      "slate400": { "$type": "color", "$value": "#94A3B8" },
      "slate500": { "$type": "color", "$value": "#64748B" },
      "slate600": { "$type": "color", "$value": "#475569" },
      "brand50": { "$type": "color", "$value": "#EEF0FF" },
      "brand100": { "$type": "color", "$value": "#C5C7F0" },
      "brand300": { "$type": "color", "$value": "#8890E8" },
      "brand500": { "$type": "color", "$value": "#2B54E8" },
      "brand600": { "$type": "color", "$value": "#2563EB" },
      "brand700": { "$type": "color", "$value": "#1A3AB8" },
      "logoSurface": { "$type": "color", "$value": "#F8F4E7" },
      "logoInk": { "$type": "color", "$value": "#56503C" },
      "success50": { "$type": "color", "$value": "#E8F6EE" },
      "success400": { "$type": "color", "$value": "#4CBB87" },
      "success700": { "$type": "color", "$value": "#1A7A4A" },
      "warning50": { "$type": "color", "$value": "#FEF5E7" },
      "warning400": { "$type": "color", "$value": "#F5A623" },
      "warning700": { "$type": "color", "$value": "#A05800" },
      "danger50": { "$type": "color", "$value": "#FEF0F0" },
      "danger400": { "$type": "color", "$value": "#E85C5C" },
      "danger700": { "$type": "color", "$value": "#C0392B" },
      "info50": { "$type": "color", "$value": "#EAF2FF" },
      "info700": { "$type": "color", "$value": "#1D4ED8" }
    },
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
        },
        "ko": {
          "$type": "fontFamily",
          "$value": "'Apple SD Gothic Neo', 'Malgun Gothic', 'Nanum Gothic', 'Noto Sans KR', system-ui, sans-serif"
        }
      },
      "weight": {
        "regular": { "$type": "fontWeight", "$value": "400" },
        "medium": { "$type": "fontWeight", "$value": "500" },
        "semibold": { "$type": "fontWeight", "$value": "600" },
        "bold": { "$type": "fontWeight", "$value": "700" },
        "heavy": { "$type": "fontWeight", "$value": "800" }
      }
    }
  },
  "color": {
    "bg": {
      "default": { "$type": "color", "$value": "{primitive.color.white}" },
      "subtle": { "$type": "color", "$value": "{primitive.color.slate50}" },
      "muted": { "$type": "color", "$value": "{primitive.color.slate100}" },
      "brandSubtle": { "$type": "color", "$value": "{primitive.color.brand50}" }
    },
    "surface": {
      "default": { "$type": "color", "$value": "{primitive.color.white}" },
      "raised": { "$type": "color", "$value": "rgba(255, 255, 255, 0.94)" },
      "inverse": { "$type": "color", "$value": "{primitive.color.black}" },
      "brand": { "$type": "color", "$value": "{primitive.color.logoSurface}" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{primitive.color.black}" },
      "secondary": { "$type": "color", "$value": "{primitive.color.slate500}" },
      "muted": { "$type": "color", "$value": "{primitive.color.slate400}" },
      "brand": { "$type": "color", "$value": "{primitive.color.brand600}" },
      "inverse": { "$type": "color", "$value": "{primitive.color.white}" },
      "danger": { "$type": "color", "$value": "#991B1B" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "rgba(15, 23, 42, 0.08)" },
      "default": { "$type": "color", "$value": "rgba(15, 23, 42, 0.12)" },
      "strong": { "$type": "color", "$value": "{primitive.color.slate200}" },
      "brand": { "$type": "color", "$value": "rgba(37, 99, 235, 0.18)" },
      "danger": { "$type": "color", "$value": "rgba(185, 28, 28, 0.18)" }
    },
    "status": {
      "real": {
        "bg": { "$type": "color", "$value": "{primitive.color.success50}" },
        "fg": { "$type": "color", "$value": "{primitive.color.success700}" },
        "accent": { "$type": "color", "$value": "{primitive.color.success400}" }
      },
      "suspicious": {
        "bg": { "$type": "color", "$value": "{primitive.color.warning50}" },
        "fg": { "$type": "color", "$value": "{primitive.color.warning700}" },
        "accent": { "$type": "color", "$value": "{primitive.color.warning400}" }
      },
      "ad": {
        "bg": { "$type": "color", "$value": "{primitive.color.danger50}" },
        "fg": { "$type": "color", "$value": "{primitive.color.danger700}" },
        "accent": { "$type": "color", "$value": "{primitive.color.danger400}" }
      },
      "info": {
        "bg": { "$type": "color", "$value": "{primitive.color.info50}" },
        "fg": { "$type": "color", "$value": "{primitive.color.info700}" }
      }
    }
  },
  "font": {
    "display": { "$type": "typography", "$value": { "fontSize": "22px", "fontWeight": "500", "lineHeight": "1.2" } },
    "title": { "$type": "typography", "$value": { "fontSize": "17px", "fontWeight": "600", "lineHeight": "1.25" } },
    "subtitle": { "$type": "typography", "$value": { "fontSize": "14px", "fontWeight": "600", "lineHeight": "1.35" } },
    "body": { "$type": "typography", "$value": { "fontSize": "13px", "fontWeight": "400", "lineHeight": "1.6" } },
    "caption": { "$type": "typography", "$value": { "fontSize": "11px", "fontWeight": "400", "lineHeight": "1.45" } },
    "label": { "$type": "typography", "$value": { "fontSize": "11px", "fontWeight": "800", "lineHeight": "1.2", "letterSpacing": "0.08em" } }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "7": { "$type": "dimension", "$value": "28px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "18px" },
    "pill": { "$type": "dimension", "$value": "999px" },
    "circle": { "$type": "dimension", "$value": "50%" }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": "0 5px 16px rgba(15, 23, 42, 0.08)" },
    "md": { "$type": "shadow", "$value": "0 8px 24px rgba(15, 23, 42, 0.10)" },
    "lg": { "$type": "shadow", "$value": "0 12px 32px rgba(15, 23, 42, 0.16)" },
    "focus": { "$type": "shadow", "$value": "0 0 0 2px rgba(37, 99, 235, 0.35)" }
  },
  "focus": {
    "ring": { "$type": "color", "$value": "{primitive.color.brand600}" },
    "width": { "$type": "dimension", "$value": "2px" },
    "offset": { "$type": "dimension", "$value": "2px" }
  },
  "button": {
    "height": {
      "sm": { "$type": "dimension", "$value": "36px" },
      "md": { "$type": "dimension", "$value": "42px" },
      "lg": { "$type": "dimension", "$value": "50px" }
    },
    "primary": {
      "bg": { "$type": "color", "$value": "{color.surface.inverse}" },
      "text": { "$type": "color", "$value": "{color.text.inverse}" }
    },
    "secondary": {
      "bg": { "$type": "color", "$value": "{color.surface.default}" },
      "text": { "$type": "color", "$value": "{color.text.primary}" },
      "border": { "$type": "color", "$value": "{color.border.default}" }
    },
    "ghost": {
      "bg": { "$type": "color", "$value": "transparent" },
      "text": { "$type": "color", "$value": "{color.text.secondary}" }
    },
    "danger": {
      "bg": { "$type": "color", "$value": "{color.status.ad.bg}" },
      "text": { "$type": "color", "$value": "#B91C1C" },
      "border": { "$type": "color", "$value": "{color.border.danger}" }
    }
  },
  "input": {
    "bg": { "$type": "color", "$value": "{color.surface.default}" },
    "text": { "$type": "color", "$value": "{color.text.primary}" },
    "placeholder": { "$type": "color", "$value": "{color.text.muted}" },
    "border": { "$type": "color", "$value": "{color.border.default}" },
    "focusBorder": { "$type": "color", "$value": "{color.text.brand}" },
    "errorBorder": { "$type": "color", "$value": "{color.status.ad.accent}" }
  },
  "card": {
    "bg": { "$type": "color", "$value": "{color.surface.default}" },
    "border": { "$type": "color", "$value": "{color.border.subtle}" },
    "radius": { "$type": "dimension", "$value": "{radius.lg}" },
    "shadow": { "$type": "shadow", "$value": "{shadow.sm}" }
  },
  "badge": {
    "real": { "bg": { "$type": "color", "$value": "{color.status.real.bg}" }, "text": { "$type": "color", "$value": "{color.status.real.fg}" } },
    "suspicious": { "bg": { "$type": "color", "$value": "{color.status.suspicious.bg}" }, "text": { "$type": "color", "$value": "{color.status.suspicious.fg}" } },
    "ad": { "bg": { "$type": "color", "$value": "{color.status.ad.bg}" }, "text": { "$type": "color", "$value": "{color.status.ad.fg}" } },
    "info": { "bg": { "$type": "color", "$value": "{color.status.info.bg}" }, "text": { "$type": "color", "$value": "{color.status.info.fg}" } }
  },
  "toast": {
    "bg": { "$type": "color", "$value": "rgba(17, 24, 39, 0.94)" },
    "text": { "$type": "color", "$value": "{color.text.inverse}" },
    "radius": { "$type": "dimension", "$value": "{radius.pill}" },
    "shadow": { "$type": "shadow", "$value": "{shadow.md}" }
  }
}
